DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
NODE_ENV=development
PORT=4000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# Automotive AI assistant. Keys stay on the backend. No paid models/fallbacks.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
GROQ_API_KEY=
GROQ_MODEL=
# Set true only after verifying Groq uses the Free Plan, never Developer billing.
GROQ_FREE_TIER_CONFIRMED=false
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW_MS=600000
CHAT_TIMEOUT_MS=30000
# Exact Next.js/reverse-proxy IPs allowed to forward client IPs; empty trusts none.
CHAT_TRUSTED_PROXY_IPS=
