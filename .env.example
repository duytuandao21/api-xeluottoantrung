DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
NODE_ENV=development
PERF_DIAGNOSTICS=false
PORT=4000
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_ISSUER=
SUPABASE_JWKS_URL=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
RATE_LIMIT_TTL_MS=60000
RATE_LIMIT_MAX=100

# Public API cache. Confirm a single API process before enabling (Node or PM2 fork).
# Cluster/multiple replicas must keep this off; cache is process-local.
PUBLIC_CACHE_ENABLED=false
PUBLIC_CACHE_MODE=off
PUBLIC_CACHE_PROCESS_COUNT=0
PUBLIC_CACHE_MAX_ENTRIES=256
PUBLIC_CACHE_MAX_BYTES=8388608

# Automotive AI assistant. Keys stay on the backend. No paid models/fallbacks.
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3.8-27b:free
GROQ_API_KEY=
GROQ_MODEL=
# Set true only after verifying Groq uses the Free Plan, never Developer billing.
GROQ_FREE_TIER_CONFIRMED=false
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW_MS=600000
CHAT_TIMEOUT_MS=30000
# Exact Next.js/reverse-proxy IPs allowed to forward client IPs; empty trusts none.
CHAT_TRUSTED_PROXY_IPS=
# Cloudflare Analytics: BACKEND ONLY. Never use NEXT_PUBLIC_ for these credentials.
# Optional integration: leave blank to show N/A without affecting other modules.
# Token: Zone Analytics Read; optional Account Analytics Read for Web Analytics.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ZONE_ID=
# Optional: skips Zone Read lookup when provided. Account containing the Web Analytics site.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_ANALYTICS_HOSTNAME=toantrungxeluot.io.vn
